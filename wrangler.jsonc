{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "textile-managemnt",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-05",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "textile-managemnt"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tixtile",
			"database_id": "text"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}